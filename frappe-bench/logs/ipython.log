# Create or update Administrator
if not frappe.db.exists("User", "Administrator"):
    admin = frappe.new_doc("User")
    admin.update({
        "name": "Administrator",
        "email": "admin@bizpro.com",
        "first_name": "Admin",
        "enabled": 1,
        "user_type": "System User",
    })
    admin.insert(ignore_permissions=True, ignore_links=True)
    frappe.db.commit()
    print("Administrator created.")
else:
    admin = frappe.get_doc("User", "Administrator")
    if not admin.enabled:
        admin.enabled = 1
        admin.save(ignore_permissions=True)
        frappe.db.commit()
        print("Administrator updated to enabled.")
    else:
        print("Administrator already enabled.")
